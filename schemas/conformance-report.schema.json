{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vate:schema:conformance-report:2026-09",
  "title": "VATE Conformance Report",
  "description": "Machine-readable report emitted by the VATE AL2 conformance runner.",
  "type": "object",
  "required": [
    "version",
    "profile",
    "checked_at",
    "summary",
    "corpus",
    "cases"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "vate-conformance-report-2026-09"
    },
    "profile": {
      "type": "string",
      "const": "VATE-AL2-Verifier-Admission-v0.3"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "passed",
        "failed",
        "skipped"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "corpus": {
      "type": "object",
      "required": [
        "name",
        "root",
        "artifact_count",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "artifact_count": {
          "type": "integer",
          "minimum": 0
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": true
    },
    "sut_results": {
      "type": "object",
      "required": [
        "path",
        "digest",
        "digest_basis",
        "artifact_mode",
        "artifact_mode_counts",
        "implementation"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "digest_basis": {
          "type": "string",
          "const": "json-sorted-no-whitespace"
        },
        "artifact_mode": {
          "type": "string",
          "description": "Default mode declared by the SUT result. Effective per-case usage is recorded in artifact_mode_counts and cases[].artifact_mode.",
          "enum": [
            "corpus-fixture-validation",
            "generated-receipts"
          ]
        },
        "artifact_mode_counts": {
          "$ref": "#/$defs/artifactModeCounts"
        },
        "implementation": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "category",
          "expected_outcome",
          "actual_outcome",
          "expected_should_execute",
          "actual_should_execute",
          "expected_primary_reason_code",
          "actual_primary_reason_code",
          "expected_reason_codes",
          "actual_reason_codes",
          "pass",
          "failures"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "artifact_mode": {
            "type": "string",
            "enum": [
              "corpus-fixture-validation",
              "generated-receipts"
            ]
          },
          "expected_outcome": {
            "type": "string",
            "minLength": 1
          },
          "actual_outcome": {
            "type": "string",
            "minLength": 1
          },
          "expected_should_execute": {
            "type": "boolean"
          },
          "actual_should_execute": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "expected_primary_reason_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "The first non-terminal expected reason code, excluding POLICY_MATCH and FAIL_CLOSED.",
            "minLength": 1
          },
          "actual_primary_reason_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "The first non-terminal actual reason code, excluding POLICY_MATCH and FAIL_CLOSED.",
            "minLength": 1
          },
          "expected_reason_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "actual_reason_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "pass": {
            "type": "boolean"
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "request_binding": {
            "type": "object",
            "required": [
              "assessment",
              "failures"
            ],
            "properties": {
              "assessment": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/requestBindingAssessment"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "failures": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "request_binding_required": {
            "type": "boolean",
            "description": "The selected corpus case requires request-preimage assessment."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "pass": {
                  "const": true
                }
              },
              "required": [
                "pass"
              ]
            },
            "then": {
              "properties": {
                "failures": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "failures": {
                  "minItems": 1
                }
              }
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "fatal_errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "request_binding_coverage": {
      "type": "object",
      "description": "Counts of case-required preimage checks, separate from corpus pass. Absence in a historical report establishes no binding coverage.",
      "required": [
        "required_cases",
        "satisfied_cases",
        "not_required_cases",
        "all_cases_satisfied"
      ],
      "properties": {
        "required_cases": {
          "type": "integer",
          "minimum": 0
        },
        "satisfied_cases": {
          "type": "integer",
          "minimum": 0
        },
        "not_required_cases": {
          "type": "integer",
          "minimum": 0
        },
        "all_cases_satisfied": {
          "type": "boolean",
          "description": "True only for a nonempty case set in which every case required and satisfied request binding; not execution authorization."
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "sut_results"
        ]
      },
      "then": {
        "properties": {
          "cases": {
            "items": {
              "required": [
                "artifact_mode"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "request_binding_coverage"
            ]
          },
          {
            "properties": {
              "cases": {
                "contains": {
                  "anyOf": [
                    {
                      "required": [
                        "request_binding_required"
                      ]
                    },
                    {
                      "required": [
                        "request_binding"
                      ]
                    }
                  ]
                }
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "request_binding_coverage"
        ],
        "properties": {
          "cases": {
            "items": {
              "required": [
                "request_binding_required"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "artifactModeCounts": {
      "type": "object",
      "required": [
        "corpus-fixture-validation",
        "generated-receipts"
      ],
      "properties": {
        "corpus-fixture-validation": {
          "type": "integer",
          "minimum": 0
        },
        "generated-receipts": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "digest": {
      "type": "object",
      "required": [
        "alg",
        "value"
      ],
      "properties": {
        "alg": {
          "type": "string",
          "const": "sha-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "requestBindingAssessment": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "vate-request-binding-assessment-v1"
        },
        "required_contract": {
          "type": "string",
          "minLength": 1
        },
        "receipt_digest": {
          "type": "object",
          "properties": {
            "alg": {
              "const": "sha-256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            }
          },
          "required": [
            "alg",
            "value"
          ],
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "checked",
            "not_checked"
          ]
        },
        "pass": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "binding_requirement_met": {
          "type": "boolean"
        },
        "decision_allows_immediate_execution": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "checked",
                  "not_checked"
                ]
              },
              "pass": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "cause": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "status",
              "pass"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "checked"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "pass": {
                      "type": "boolean"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "pass": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "required": [
        "contract",
        "required_contract",
        "receipt_digest",
        "status",
        "pass",
        "binding_requirement_met",
        "decision_allows_immediate_execution",
        "checks"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "checked"
              }
            }
          },
          "then": {
            "properties": {
              "pass": {
                "type": "boolean"
              }
            }
          },
          "else": {
            "properties": {
              "pass": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "binding_requirement_met": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "checked"
              },
              "pass": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision_allows_immediate_execution": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "binding_requirement_met": {
                "const": true
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
