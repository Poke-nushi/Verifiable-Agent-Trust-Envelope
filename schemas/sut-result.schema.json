{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vate:schema:sut-result:2026-07",
  "title": "VATE SUT Result Set",
  "description": "Machine-readable results emitted by a system under test for one VATE conformance corpus snapshot.",
  "type": "object",
  "required": [
    "version",
    "profile",
    "generated_at",
    "implementation",
    "corpus",
    "results"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "vate-sut-results-2026-07"
    },
    "profile": {
      "type": "string",
      "const": "VATE-AL2-Verifier-Admission-v0.3"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_mode": {
      "type": "string",
      "description": "Default artifact evidence mode. corpus-fixture-validation records references matching committed corpus artifacts. generated-receipts additionally requires locally verifiable receipt artifacts submitted as SUT output and cannot be downgraded by a per-case override.",
      "enum": [
        "corpus-fixture-validation",
        "generated-receipts"
      ],
      "default": "corpus-fixture-validation"
    },
    "implementation": {
      "type": "object",
      "required": [
        "name",
        "type",
        "version",
        "language"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "corpus": {
      "type": "object",
      "required": [
        "profile",
        "digest"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "const": "VATE-AL2-Verifier-Admission-v0.3"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": true
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "status",
          "outcome",
          "should_execute",
          "reason_codes"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_mode": {
            "type": "string",
            "description": "Optional per-case override of the top-level artifact evidence mode. A corpus-fixture-validation default may opt selected cases into generated-receipts; a generated-receipts default cannot be downgraded.",
            "enum": [
              "corpus-fixture-validation",
              "generated-receipts"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "skipped",
              "error"
            ]
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "should_execute": {
            "type": "boolean"
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "pass"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "pass": {
                  "type": "boolean"
                },
                "details": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "artifacts": {
            "type": "object",
            "description": "Exact corpus fixture artifacts evaluated by the SUT. Their digests must match the selected corpus snapshot; they are not SUT-generated output artifacts.",
            "properties": {
              "admission_receipt": {
                "$ref": "#/$defs/receiptArtifactRef"
              },
              "post_execution_receipt": {
                "$ref": "#/$defs/receiptArtifactRef"
              },
              "verification_context": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/verificationContextRef"
                }
              },
              "proof_artifacts": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/proofArtifactRef"
                }
              }
            },
            "additionalProperties": true
          },
          "generated_artifacts": {
            "type": "object",
            "description": "Receipt artifacts submitted as SUT output and used only with artifact_mode generated-receipts. compare reads the local artifact bytes, verifies their submitted digests, and checks their schema-aligned bounded semantic projection.",
            "properties": {
              "admission_receipt": {
                "$ref": "#/$defs/receiptArtifactRef"
              },
              "post_execution_receipt": {
                "$ref": "#/$defs/receiptArtifactRef"
              }
            },
            "additionalProperties": false
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "required": [
        "alg",
        "value"
      ],
      "properties": {
        "alg": {
          "type": "string",
          "const": "sha-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "receiptArtifactRef": {
      "type": "object",
      "required": [
        "uri",
        "media_type",
        "digest"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "local_path": {
          "type": "string",
          "description": "Optional relative path used by compare to read generated artifact bytes when uri is a remote publication identifier. It resolves only within the directory containing the SUT result; absolute paths, parent traversal, and symlink escapes are rejected.",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": true
    },
    "verificationContextRef": {
      "type": "object",
      "required": [
        "kind",
        "case_artifact",
        "uri",
        "digest",
        "context_bindings"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "case_artifact": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "context_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/contextBinding"
          }
        }
      },
      "additionalProperties": true
    },
    "contextBinding": {
      "type": "object",
      "required": [
        "role",
        "source_artifact"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "admission_receipt",
            "admission_request",
            "transaction_id",
            "runtime",
            "evidence"
          ]
        },
        "source_artifact": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "evidence_type": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "enum": [
                  "admission_receipt",
                  "admission_request"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "enum": [
                  "transaction_id",
                  "runtime"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "path",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "evidence"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "path",
              "evidence_type",
              "digest"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "proofArtifactRef": {
      "type": "object",
      "required": [
        "kind",
        "case_artifact",
        "uri",
        "media_type",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "jose_proof_package",
            "jose_detached_payload",
            "jose_trust_bundle"
          ]
        },
        "case_artifact": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
