  "case_id": "deny-digest-mismatch-before-policy",
  "title": "Deny execution on a digest mismatch",
  "category": "negative",
  "purpose": "A verifier should fail closed on a digest mismatch so that local policy or attenuation cannot override the denial to permit execution. compare checks the reported outcome and required artifact bindings, not the SUT's internal evaluation order. See docs/conformance/corpus-format.md#validation-focus-boundary.",
  "artifacts": {
    "base_artifact": "examples/admission-request.example.json",
