    "checks": [
      {
        "name": "decision.outcome",
        "expected": "fail"
      },
      {
        "name": "evidence.verification.failure_reason",
        "expected": "present"
      },
      {
        "name": "policy.policy_version",
        "expected": "present"
      }
    ]
  },
  "validation_focus": [
    "digest-bound reference",
    "terminal integrity denial",
    "non-overridable denial before execution",
    "execution gate"
  ]
