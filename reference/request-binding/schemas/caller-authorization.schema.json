    "principal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "runtime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "authority_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "grant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
