{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vate:schema:request-binding:caller-authorization:v1",
  "description": "Local request-specific caller authorization result. A received copy is not authority to execute. Proof bytes are not included.",
  "type": "object",
  "properties": {
