      "const": "vate-caller-authorization-v1"
    },
    "proof_ref": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^urn:sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "object",
          "properties": {
            "alg": {
              "const": "sha-256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            }
          },
          "required": [
            "alg",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "uri",
        "media_type",
        "digest"
      ],
      "additionalProperties": false
    },
    "admission_request_ref": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^urn:sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "media_type": {
          "const": "application/json"
        },
        "digest": {
          "type": "object",
          "properties": {
            "alg": {
              "const": "sha-256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            }
          },
          "required": [
            "alg",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "uri",
        "media_type",
        "digest"
      ],
      "additionalProperties": false
    },
    "original_ref": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^urn:sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "media_type": {
          "const": "application/json"
        },
        "digest": {
          "type": "object",
          "properties": {
            "alg": {
              "const": "sha-256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
