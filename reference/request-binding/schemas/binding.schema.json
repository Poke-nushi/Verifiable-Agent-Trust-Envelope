          "type": "string",
          "pattern": "^urn:sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "media_type": {
          "const": "application/json"
        },
        "digest": {
          "type": "object",
          "properties": {
            "alg": {
              "const": "sha-256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            }
