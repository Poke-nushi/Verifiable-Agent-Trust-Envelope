{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vate:schema:request-binding:operation:v1",
  "type": "object",
  "properties": {
    "preimage_profile": {
      "const": "vate-purchase-cap-request-v1"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "const": "commerce.purchase"
    },
    "target": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "resource",
        "audience"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "order_id": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}(?![\\s\\S])"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?(?![\\s\\S])"
            }
          },
          "required": [
            "currency",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "tool",
        "order_id",
        "amount"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_amount": {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}(?![\\s\\S])"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?(?![\\s\\S])"
            }
          },
          "required": [
            "currency",
            "value"
          ],
          "additionalProperties": false
        },
        "tool_allowlist": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "max_amount",
        "tool_allowlist"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "preimage_profile",
    "operation_id",
    "action",
    "target",
    "payload",
    "constraints"
  ],
  "additionalProperties": false
}
