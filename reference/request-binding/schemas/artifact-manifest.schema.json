{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vate:schema:request-binding:artifact-manifest:v1",
  "type": "object",
  "required": [
    "contract",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "vate-request-binding-artifact-manifest-v1"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "uri",
          "media_type",
          "digest",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string",
            "pattern": "^urn:sha256:[0-9a-f]{64}(?![\\s\\S])"
          },
          "media_type": {
            "const": "application/json"
          },
          "digest": {
            "type": "object",
            "properties": {
              "alg": {
                "const": "sha-256"
              },
              "value": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              }
            },
            "required": [
              "alg",
              "value"
            ],
            "additionalProperties": false
          },
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}\\.json(?![\\s\\S])"
          }
        }
      }
    }
  }
}
